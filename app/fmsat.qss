/* FMSAT_PALETTE
canvas: #f7f7f5;
surface: #101f2e;
accentStrong: #239b78;
textSoft: #f0f0f0;
textPrimary: #f5f8fb;
textMuted: #8fa3b8;
textSecondary: #d9e5ef;
accentHover: #56d6b0;
successSurface: #163b38;
successText: #75e0bf;
successBorder: #28675e;
border: #263b4e;
borderMuted: #203548;
warningSurface: #40351c;
warningText: #f0c76a;
warningBorder: #735f2d;
errorSurface: #442329;
errorText: #ff9da7;
errorBorder: #7b3943;
neutralSurface: #243545;
neutralText: #9fb0c0;
neutralBorder: #405366;
bannerBorder: #8f5b2f;
bannerTitle: #ffd29a;
bannerText: #f4d9b5;
accent: #31b98f;
onAccent: #061510;
disabledSurface: #9bbbad;
disabledText: #52645d;
borderStrong: #30465a;
dialogText: #e8eef5;
importanceBlue: #1a3044;
inactiveText: #60788e;
*/

QWidget#tacticDetailView, QWidget#squadDetailView { background: {{canvas}}; color: {{surface}}; }
QLabel#eyebrow, QLabel#factKey, QLabel#factLabel { color: {{accentStrong}}; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
QLabel#workspaceHeading { color: {{accentStrong}}; font-size: 15px; font-weight: 700; letter-spacing: 1px; }
QLabel#pageTitle { color: {{surface}}; font-size: 28px; font-weight: 700; min-height: 34px; }
QLabel#factValue { color: {{textSoft}}; font-size: 14px; font-weight: 600; }
QLabel#cardTitle, QLabel#emptyTitle { color: {{textPrimary}}; font-size: 17px; font-weight: 700; }
QLabel#mutedText { color: {{textMuted}}; }
QLabel#overviewFieldKey { color: {{textSecondary}}; font-weight: 700; }
QLabel#overviewFieldValue { color: {{textMuted}}; }
QLabel#emptyIcon { color: {{accentHover}}; font-size: 52px; }
QLabel#summaryItem { background: {{surface}}; color: {{textPrimary}}; border-radius: 7px; padding: 10px; }
QLabel#valuePill { background: {{successSurface}}; color: {{successText}}; border: 1px solid {{successBorder}}; border-radius: 9px; padding: 4px 9px; }
QFrame#factCard, QFrame#panel, QFrame#instructionCard { background: {{surface}}; border: 1px solid {{border}}; border-radius: 10px; }
QFrame#overviewPanel { background: {{surface}}; border: 1px solid {{border}}; border-radius: 10px; }
QFrame#validationPanel { background: {{surface}}; border: 1px solid {{border}}; border-radius: 10px; }
QFrame#validationPhase { background: {{surface}}; border: 1px solid {{borderMuted}}; border-radius: 6px; }
QLabel#validationPhaseName { color: {{textSecondary}}; font-weight: 600; }
QLabel#validationStatus, QLabel#validationPhaseCount { border-radius: 8px; padding: 3px 8px; font-weight: 700; }
QLabel#validationStatus[validationState="passed"], QLabel#validationPhaseCount[validationState="passed"] { background: {{successSurface}}; color: {{successText}}; border: 1px solid {{successBorder}}; }
QLabel#validationStatus[validationState="warning"], QLabel#validationPhaseCount[validationState="warning"] { background: {{warningSurface}}; color: {{warningText}}; border: 1px solid {{warningBorder}}; }
QLabel#validationStatus[validationState="error"] { background: {{errorSurface}}; color: {{errorText}}; border: 1px solid {{errorBorder}}; }
QLabel#validationStatus[validationState="unknown"], QLabel#validationPhaseCount[validationState="unknown"] { background: {{neutralSurface}}; color: {{neutralText}}; border: 1px solid {{neutralBorder}}; }
QLabel#validationIssue { color: {{warningText}}; }
QLabel#validationPassed { color: {{successText}}; }
QFrame#pitchPanel { background: {{surface}}; border: 1px solid {{border}}; border-radius: 10px; }
QFrame#incompleteBanner { background: {{surface}}; border: 1px solid {{bannerBorder}}; border-radius: 10px; padding: 8px; }
QLabel#incompleteBannerTitle { color: {{bannerTitle}}; font-size: 14px; font-weight: 700; }
QLabel#incompleteBannerText { color: {{bannerText}}; }
QFrame#factCard { min-height: 58px; }
QWidget#tacticDetailView QPushButton, QWidget#squadDetailView QPushButton, QToolButton#playerFilterButton { background: {{accent}}; color: {{onAccent}}; border: 1px solid {{accent}}; border-radius: 7px; padding: 9px 15px; font-weight: 700; }
QWidget#tacticDetailView QPushButton:hover, QWidget#squadDetailView QPushButton:hover, QToolButton#playerFilterButton:hover { background: {{accentHover}}; border-color: {{accentHover}}; color: {{onAccent}}; }
QWidget#tacticDetailView QPushButton:disabled, QWidget#squadDetailView QPushButton:disabled, QToolButton#playerFilterButton:disabled { background: {{disabledSurface}}; border-color: {{disabledSurface}}; color: {{disabledText}}; }
QPushButton#secondaryButton[copyState="copied"] { background: {{accentHover}}; color: {{onAccent}}; border-color: {{accentHover}}; }
QWidget#tacticDetailView QComboBox, QWidget#squadDetailView QComboBox { background: {{accent}}; color: {{onAccent}}; border: 1px solid {{accent}}; border-radius: 7px; padding: 8px 12px; font-weight: 700; }
QWidget#tacticDetailView QComboBox:hover, QWidget#squadDetailView QComboBox:hover { background: {{accentHover}}; border-color: {{accentHover}}; }
QWidget#tacticDetailView QComboBox:disabled, QWidget#squadDetailView QComboBox:disabled { background: {{disabledSurface}}; border-color: {{disabledSurface}}; color: {{disabledText}}; }
QComboBox { combobox-popup: 0; }
QComboBox QAbstractItemView, QComboBox QListView { background: {{surface}}; color: {{textSecondary}}; border: 1px solid {{borderStrong}}; selection-background-color: {{accentHover}}; selection-color: {{onAccent}}; }
QComboBox QAbstractItemView::item, QComboBox QListView::item { background: {{surface}}; color: {{textSecondary}}; min-height: 30px; padding: 5px 8px; }
QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected, QComboBox QListView::item:hover, QComboBox QListView::item:selected { background: {{accentHover}}; color: {{onAccent}}; }
QMenu#playerFilterMenu { background: {{surface}}; color: {{textPrimary}}; border: 1px solid {{borderStrong}}; padding: 7px; }
QMenu#playerFilterMenu QCheckBox { color: {{textPrimary}}; spacing: 9px; padding: 7px 12px; min-width: 170px; }

/* Shared dialog palette. Dialogs opened outside the squad workspace use this too. */
QDialog { background: {{surface}}; color: {{dialogText}}; }
QDialog QLabel, QDialog QRadioButton, QDialog QCheckBox, QDialog QGroupBox { color: {{textSecondary}}; }
QDialogButtonBox QPushButton { qproperty-iconSize: 0px 0px; }
QDialog QPushButton {
    background: {{accent}}; color: {{onAccent}}; border: 1px solid {{accent}};
    border-radius: 7px; padding: 7px 12px; font-weight: 700;
}
QDialog QPushButton:hover { background: {{accentHover}}; border-color: {{accentHover}}; }
QDialog QPushButton:disabled { background: {{neutralSurface}}; color: {{inactiveText}}; border-color: {{neutralBorder}}; }
QDialog QTableWidget {
    background: {{surface}}; alternate-background-color: {{surface}}; color: {{textPrimary}};
    border: 1px solid {{borderStrong}}; gridline-color: {{border}};
    selection-background-color: {{successSurface}}; selection-color: {{successText}};
}
QDialog QTableWidget::item { color: {{textPrimary}}; padding: 4px; }
QDialog QTableWidget::item:selected { background: {{successSurface}}; color: {{successText}}; }

/* Role-weight matrix semantic palettes. QTableWidgetItems consume these via
   hidden provider widgets because individual items are not QSS objects. */
QWidget#roleWeightDefault { background: {{surface}}; color: {{textPrimary}}; }
QWidget#roleWeightInactive { background: {{surface}}; color: {{inactiveText}}; }
QWidget#roleWeightTopThree { background: {{successSurface}}; color: {{textPrimary}}; }
QWidget#roleWeightImportant { background: {{importanceBlue}}; color: {{textPrimary}}; }
QWidget#roleWeightNiceToHave { background: {{neutralSurface}}; color: {{textPrimary}}; }
QDialog QComboBox {
    background: {{surface}}; color: {{textPrimary}}; border: 1px solid {{borderStrong}};
    border-radius: 5px; padding: 5px 7px;
}
QInputDialog { min-width: 520px; }
QLineEdit, QTextEdit, QPlainTextEdit { background: {{surface}}; color: {{textPrimary}}; border: 1px solid {{borderStrong}}; border-radius: 6px; padding: 8px; }
QTreeWidget#playerTraitList { background: {{surface}}; alternate-background-color: {{surface}}; color: {{textPrimary}}; border: 1px solid {{borderStrong}}; }
QTreeWidget#playerTraitList::item { padding: 7px; }
QTreeWidget#playerTraitList::item:hover { background: {{surface}}; }
QTreeWidget#playerTraitList::item:selected { background: {{successSurface}}; color: {{successText}}; }
QTableWidget#squadPlayersTable, QTableWidget#roleAssessmentTable, QTableWidget#roleCandidateTable,
QTableWidget#roleDepthAnalysisTable, QTableWidget#playerRoleAnalysisTable, QTableWidget#squadFindingsTable {
    background: {{surface}}; alternate-background-color: {{surface}}; color: {{textPrimary}};
    border: 1px solid {{borderStrong}}; gridline-color: {{border}}; selection-background-color: {{successSurface}};
    selection-color: {{successText}};
}
QWidget#squadDetailView QTableWidget#roleAssessmentTable, QWidget#squadDetailView QTableWidget#roleCandidateTable { min-height: 240px; }
QWidget#squadDetailView QTableWidget#playerRoleAnalysisTable { min-height: 165px; }
QTableWidget#roleCandidateTable, QTableWidget#playerRoleAnalysisTable, QTableWidget#squadFindingsTable { qproperty-wordWrap: false; qproperty-textElideMode: ElideRight; }
QTableWidget#squadPlayersTable QWidget#qt_scrollarea_viewport,
QTableWidget#roleAssessmentTable QWidget#qt_scrollarea_viewport,
QTableWidget#roleCandidateTable QWidget#qt_scrollarea_viewport,
QTableWidget#roleDepthAnalysisTable QWidget#qt_scrollarea_viewport,
QTableWidget#playerRoleAnalysisTable QWidget#qt_scrollarea_viewport,
QTableWidget#squadFindingsTable QWidget#qt_scrollarea_viewport { background: {{surface}}; }
QTableCornerButton::section { background: {{surface}}; border: 0; border-right: 1px solid {{borderStrong}}; border-bottom: 1px solid {{borderStrong}}; }
QTableWidget#squadPlayersTable::item, QTableWidget#roleAssessmentTable::item, QTableWidget#roleDepthAnalysisTable::item { padding: 5px; }
QTableWidget#roleCandidateTable::item, QTableWidget#playerRoleAnalysisTable::item, QTableWidget#squadFindingsTable::item { padding: 2px 5px; }
QTableWidget#squadPlayersTable::item:selected, QTableWidget#roleAssessmentTable::item:selected, QTableWidget#roleCandidateTable::item:selected,
QTableWidget#roleDepthAnalysisTable::item:selected, QTableWidget#playerRoleAnalysisTable::item:selected, QTableWidget#squadFindingsTable::item:selected { background: {{successSurface}}; color: {{successText}}; }
QHeaderView { background: {{surface}}; }
QHeaderView::section { background: {{surface}}; color: {{textSecondary}}; border: 0; border-right: 1px solid {{borderStrong}}; padding: 6px; font-weight: 700; }
QTabWidget::pane { border: 0; background: transparent; }
QTabBar::tab { color: {{inactiveText}}; padding: 11px 22px; border-bottom: 2px solid transparent; font-weight: 600; }
QTabBar::tab:selected { color: {{accentStrong}}; border-bottom-color: {{accent}}; }
QScrollArea { background: transparent; }
QScrollArea#validationIssueScroll { background: {{surface}}; border: 1px solid {{borderMuted}}; }
QWidget#validationIssueContent { background: {{surface}}; }

/* Focused player editor */
QDialog#playerEditorDialog { background: {{surface}}; color: {{dialogText}}; }
QDialog#playerEditorDialog QLabel { color: {{textSecondary}}; }
QDialog#playerEditorDialog QLabel#playerEditorContext { color: {{textMuted}}; padding: 0 2px 2px 2px; }
QDialog#playerEditorDialog QGroupBox#playerEditorSection {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 7px;
    font-weight: 700;
    color: {{textSecondary}};
}
QDialog#playerEditorDialog QGroupBox#playerEditorSection::title {
    subcontrol-origin: margin;
    left: 11px;
    padding: 0 5px;
    color: {{accentHover}};
}
QDialog#playerEditorDialog QLineEdit {
    background: {{surface}};
    color: {{textPrimary}};
    border: 1px solid {{borderStrong}};
    border-radius: 6px;
    padding: 7px 9px;
    min-height: 19px;
}
QDialog#playerEditorDialog QLineEdit:focus { border-color: {{accentHover}}; }
QDialog#playerEditorDialog QLabel#playerEvidenceStatus {
    background: {{successSurface}};
    color: {{successText}};
    border: 1px solid {{successBorder}};
    border-radius: 8px;
    padding: 3px 8px;
    font-weight: 700;
}
QScrollArea#playerAttributeScroll { background: {{surface}}; border: 0; }
QWidget#playerAttributeContainer { background: {{surface}}; }
QLabel#playerAttributeLabel { color: {{textSecondary}}; font-weight: 700; min-width: 112px; }
QSpinBox#playerAttributeInput {
    background: {{surface}};
    color: {{textPrimary}};
    border: 1px solid {{borderStrong}};
    border-radius: 5px;
    padding: 5px 7px;
    min-height: 20px;
}
QSpinBox#playerAttributeInput:focus { border-color: {{accentHover}}; }
QSpinBox#playerAttributeInput::up-button, QSpinBox#playerAttributeInput::down-button {
    background: {{surface}};
    border: 0;
    border-left: 1px solid {{borderStrong}};
    width: 18px;
}
QLabel#playerTraitsSummary {
    background: {{surface}};
    color: {{textSecondary}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 8px 10px;
}
QDialog#playerEditorDialog QPushButton#primaryButton,
QDialog#playerTraitDialog QPushButton {
    background: {{accent}};
    color: {{onAccent}};
    border: 1px solid {{accent}};
    border-radius: 7px;
    padding: 8px 14px;
    font-weight: 700;
}
QDialog#playerEditorDialog QPushButton#primaryButton:hover,
QDialog#playerTraitDialog QPushButton:hover {
    background: {{accentHover}};
    border-color: {{accentHover}};
}
QDialog#playerEditorDialog QPushButton#secondaryButton {
    background: {{surface}};
    color: {{textSecondary}};
    border: 1px solid {{borderStrong}};
    border-radius: 7px;
    padding: 8px 14px;
    font-weight: 700;
}
QDialog#playerEditorDialog QPushButton#secondaryButton:hover {
    background: {{importanceBlue}};
    border-color: {{accentHover}};
    color: {{textPrimary}};
}

/* Known-traits chooser */
QDialog#playerTraitDialog { background: {{surface}}; color: {{dialogText}}; }
QDialog#playerTraitDialog QLabel { color: {{textSecondary}}; }
QDialog#playerTraitDialog QLineEdit { margin-bottom: 3px; }
QDialog#playerTraitDialog QCheckBox { color: {{textSecondary}}; spacing: 8px; padding: 3px 0; }
QDialog#playerTraitDialog QCheckBox::indicator,
QDialog#playerTraitDialog QTreeWidget#playerTraitList::indicator {
    width: 15px;
    height: 15px;
    background: {{surface}};
    border: 1px solid {{inactiveText}};
    border-radius: 3px;
}
QDialog#playerTraitDialog QCheckBox::indicator:checked,
QDialog#playerTraitDialog QTreeWidget#playerTraitList::indicator:checked {
    background: {{accent}};
    border-color: {{accentHover}};
}
QDialog#playerTraitDialog QCheckBox::indicator:hover,
QDialog#playerTraitDialog QTreeWidget#playerTraitList::indicator:hover {
    border-color: {{accentHover}};
}
QDialog#playerTraitDialog QTreeWidget#playerTraitList {
    background: {{surface}};
    border: 1px solid {{borderStrong}};
    border-radius: 6px;
}
QDialog#playerTraitDialog QTreeWidget#playerTraitList::item { min-height: 26px; padding: 4px 6px; }
