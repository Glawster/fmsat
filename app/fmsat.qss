QWidget#tacticDetailView, QWidget#squadDetailView { background: #f7f7f5; color: #101f2e; }
QLabel#eyebrow, QLabel#factKey { color: #239b78; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
QLabel#workspaceHeading { color: #239b78; font-size: 15px; font-weight: 700; letter-spacing: 1px; }
QLabel#pageTitle { color: #101f2e; font-size: 28px; font-weight: 700; min-height: 34px; }
QLabel#factValue { color: #f0f0f0; font-size: 14px; font-weight: 600; }
QLabel#cardTitle, QLabel#emptyTitle { color: #f5f8fb; font-size: 17px; font-weight: 700; }
QLabel#mutedText { color: #8fa3b8; }
QLabel#overviewFieldKey { color: #d9e5ef; font-weight: 700; }
QLabel#overviewFieldValue { color: #8fa3b8; }
QLabel#emptyIcon { color: #56d6b0; font-size: 52px; }
QLabel#summaryItem { background: #101f2e; color: #f5f8fb; border-radius: 7px; padding: 10px; }
QLabel#valuePill { background: #163b38; color: #75e0bf; border: 1px solid #28675e; border-radius: 9px; padding: 4px 9px; }
QFrame#factCard, QFrame#panel, QFrame#instructionCard { background: #101f2e; border: 1px solid #263b4e; border-radius: 10px; }
QFrame#overviewPanel { background: #101f2e; border: 1px solid #263b4e; border-radius: 10px; }
QFrame#validationPanel { background: #101f2e; border: 1px solid #263b4e; border-radius: 10px; }
QFrame#validationPhase { background: #0c1926; border: 1px solid #203548; border-radius: 6px; }
QLabel#validationPhaseName { color: #d9e5ef; font-weight: 600; }
QLabel#validationStatus, QLabel#validationPhaseCount { border-radius: 8px; padding: 3px 8px; font-weight: 700; }
QLabel#validationStatus[validationState="passed"], QLabel#validationPhaseCount[validationState="passed"] { background: #163b38; color: #75e0bf; border: 1px solid #28675e; }
QLabel#validationStatus[validationState="warning"], QLabel#validationPhaseCount[validationState="warning"] { background: #40351c; color: #f0c76a; border: 1px solid #735f2d; }
QLabel#validationStatus[validationState="error"] { background: #442329; color: #ff9da7; border: 1px solid #7b3943; }
QLabel#validationStatus[validationState="unknown"], QLabel#validationPhaseCount[validationState="unknown"] { background: #243545; color: #9fb0c0; border: 1px solid #405366; }
QLabel#validationIssue { color: #f0c76a; }
QLabel#validationPassed { color: #75e0bf; }
QFrame#pitchPanel { background: #101f2e; border: 1px solid #263b4e; border-radius: 10px; }
QFrame#incompleteBanner { background: #3a2714; border: 1px solid #8f5b2f; border-radius: 10px; padding: 8px; }
QLabel#incompleteBannerTitle { color: #ffd29a; font-size: 14px; font-weight: 700; }
QLabel#incompleteBannerText { color: #f4d9b5; }
QFrame#factCard { min-height: 58px; }
QWidget#tacticDetailView QPushButton, QWidget#squadDetailView QPushButton, QToolButton#playerFilterButton { background: #31b98f; color: #061510; border: 1px solid #31b98f; border-radius: 7px; padding: 9px 15px; font-weight: 700; }
QWidget#tacticDetailView QPushButton:hover, QWidget#squadDetailView QPushButton:hover, QToolButton#playerFilterButton:hover { background: #56d6b0; border-color: #56d6b0; color: #061510; }
QWidget#tacticDetailView QPushButton:disabled, QWidget#squadDetailView QPushButton:disabled, QToolButton#playerFilterButton:disabled { background: #9bbbad; border-color: #9bbbad; color: #52645d; }
QPushButton#secondaryButton[copyState="copied"] { background: #56d6b0; color: #061510; border-color: #56d6b0; }
QWidget#tacticDetailView QComboBox, QWidget#squadDetailView QComboBox { background: #31b98f; color: #061510; border: 1px solid #31b98f; border-radius: 7px; padding: 8px 12px; font-weight: 700; }
QWidget#tacticDetailView QComboBox:hover, QWidget#squadDetailView QComboBox:hover { background: #56d6b0; border-color: #56d6b0; }
QWidget#tacticDetailView QComboBox:disabled, QWidget#squadDetailView QComboBox:disabled { background: #9bbbad; border-color: #9bbbad; color: #52645d; }
QComboBox QAbstractItemView { background: #101f2e; color: #f5f8fb; border: 1px solid #30465a; selection-background-color: #163b38; selection-color: #75e0bf; }
QMenu#playerFilterMenu { background: #101f2e; color: #f5f8fb; border: 1px solid #30465a; padding: 7px; }
QMenu#playerFilterMenu QCheckBox { color: #f5f8fb; spacing: 9px; padding: 7px 12px; min-width: 170px; }
QDialog { background: #08131f; color: #e8eef5; }
QInputDialog { min-width: 520px; }
QLineEdit, QTextEdit, QPlainTextEdit { background: #101f2e; color: #f5f8fb; border: 1px solid #30465a; border-radius: 6px; padding: 8px; }
QTreeWidget#playerTraitList { background: #101f2e; alternate-background-color: #0c1926; color: #f5f8fb; border: 1px solid #30465a; }
QTreeWidget#playerTraitList::item { padding: 7px; }
QTreeWidget#playerTraitList::item:hover { background: #132536; }
QTreeWidget#playerTraitList::item:selected { background: #163b38; color: #75e0bf; }
QTableWidget#squadPlayersTable, QTableWidget#roleAssessmentTable, QTableWidget#roleCandidateTable,
QTableWidget#roleDepthAnalysisTable, QTableWidget#playerRoleAnalysisTable, QTableWidget#squadFindingsTable {
    background: #101f2e; alternate-background-color: #0c1926; color: #f5f8fb;
    border: 1px solid #30465a; gridline-color: #263b4e; selection-background-color: #163b38;
    selection-color: #75e0bf;
}
QTableWidget#roleCandidateTable, QTableWidget#playerRoleAnalysisTable, QTableWidget#squadFindingsTable { qproperty-wordWrap: false; qproperty-textElideMode: ElideRight; }
QTableWidget#squadPlayersTable QWidget#qt_scrollarea_viewport,
QTableWidget#roleAssessmentTable QWidget#qt_scrollarea_viewport,
QTableWidget#roleCandidateTable QWidget#qt_scrollarea_viewport,
QTableWidget#roleDepthAnalysisTable QWidget#qt_scrollarea_viewport,
QTableWidget#playerRoleAnalysisTable QWidget#qt_scrollarea_viewport,
QTableWidget#squadFindingsTable QWidget#qt_scrollarea_viewport { background: #101f2e; }
QTableCornerButton::section { background: #132536; border: 0; border-right: 1px solid #30465a; border-bottom: 1px solid #30465a; }
QTableWidget#squadPlayersTable::item, QTableWidget#roleAssessmentTable::item, QTableWidget#roleDepthAnalysisTable::item { padding: 5px; }
QTableWidget#roleCandidateTable::item, QTableWidget#playerRoleAnalysisTable::item, QTableWidget#squadFindingsTable::item { padding: 2px 5px; }
QTableWidget#squadPlayersTable::item:selected, QTableWidget#roleAssessmentTable::item:selected, QTableWidget#roleCandidateTable::item:selected,
QTableWidget#roleDepthAnalysisTable::item:selected, QTableWidget#playerRoleAnalysisTable::item:selected, QTableWidget#squadFindingsTable::item:selected { background: #163b38; color: #75e0bf; }
QHeaderView { background: #101f2e; }
QHeaderView::section { background: #132536; color: #d9e5ef; border: 0; border-right: 1px solid #30465a; padding: 6px; font-weight: 700; }
QTabWidget::pane { border: 0; background: transparent; }
QTabBar::tab { color: #60788e; padding: 11px 22px; border-bottom: 2px solid transparent; font-weight: 600; }
QTabBar::tab:selected { color: #239b78; border-bottom-color: #31b98f; }
QScrollArea { background: transparent; }
QScrollArea#validationIssueScroll { background: #0c1926; border: 1px solid #203548; }
QWidget#validationIssueContent { background: #0c1926; }